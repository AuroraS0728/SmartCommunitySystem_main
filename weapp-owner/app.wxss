page {
  background: #f3f6fb;
  color: #0f172a;
  font-size: 30rpx;
  line-height: 1.72;
}

navigator {
  color: inherit;
}

.section {
  padding: 60rpx 40rpx 84rpx;
}

.hero {
  margin-bottom: 50rpx;
  padding: 52rpx 42rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  box-shadow: 0 18rpx 42rpx -24rpx rgba(15, 23, 42, 0.55);
}

.hero-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 18rpx;
  color: #cbd5e1;
  font-size: 26rpx;
}

.group-title {
  margin: 44rpx 0 30rpx;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
}

.item {
  margin-bottom: 40rpx;
  padding: 46rpx 36rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx -24rpx rgba(15, 23, 42, 0.65);
}

.item-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
}

.item-desc {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 26rpx;
}

.meta {
  margin-top: 22rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-body {
  flex: 1;
  min-width: 0;
}

.nav-arrow {
  margin-left: 22rpx;
  color: #94a3b8;
  font-size: 34rpx;
  font-weight: 700;
}

.status-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #bfdbfe;
  background: #dbeafe;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 600;
}

.field-label {
  margin-bottom: 22rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 98rpx;
  margin-bottom: 40rpx;
  padding: 32rpx 30rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 18rpx;
  background: #f8fafc;
  line-height: 1.45;
}

.picker,
.picker-trigger {
  min-height: 98rpx;
  padding-top: 26rpx;
  padding-bottom: 26rpx;
  border-radius: 18rpx;
}

.textarea {
  min-height: 300rpx;
}

.btn {
  min-height: 98rpx;
  margin-top: 34rpx;
  padding: 34rpx 28rpx;
  border-radius: 20rpx;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  box-shadow: 0 12rpx 24rpx -16rpx rgba(37, 99, 235, 0.75);
}

.link {
  margin-top: 26rpx;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}

.empty {
  margin-bottom: 32rpx;
  padding: 66rpx 38rpx;
  border: 1rpx dashed #cbd5e1;
  border-radius: 22rpx;
  background: #ffffff;
  color: #94a3b8;
  text-align: center;
}

.code {
  color: #0f172a;
  word-break: break-all;
  font-family: Consolas, Monaco, monospace;
}
