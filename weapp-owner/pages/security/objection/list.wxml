<view class="section">
  <view class="hero security-hero">
    <view class="hero-title">Fee Objection Review</view>
    <view class="hero-desc">Review owner objections and decide accept/reject.</view>
  </view>

  <view class="item">
    <view class="field-label">Status</view>
    <picker class="picker" mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
      <view class="picker-trigger input">
        {{statusValue === '' ? 'All' : (statusValue === '0' ? 'Pending' : (statusValue === '1' ? 'Rejected' : 'Accepted'))}}
      </view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="empty">Loading...</view>

  <block wx:elif="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="row-between">
        <view class="item-title">Objection #{{item.id}}</view>
        <view class="status-tag">{{item.statusText || item.status}}</view>
      </view>
      <view class="meta">Order: {{item.orderId}} ({{item.orderCategory || '--'}})</view>
      <view class="meta">Owner: {{item.ownerName || item.ownerId}}</view>
      <view class="meta">Bill amount: {{item.billAmount || 0}}</view>
      <view class="meta">Deposit points: {{item.depositPoints || 0}}</view>
      <view class="meta">Reason: {{item.reason || '--'}}</view>
      <view class="meta" wx:if="{{item.status != 0}}">Review note: {{item.resolutionRemark || '--'}}</view>
      <view class="meta" wx:if="{{item.status != 0}}">Refund points: {{item.refundPoints || 0}}</view>

      <block wx:if="{{item.status == 0}}">
        <view class="field-label">Adjusted amount (optional)</view>
        <input
          class="input"
          type="digit"
          data-id="{{item.id}}"
          data-field="adjustedAmount"
          value="{{forms[item.id].adjustedAmount || ''}}"
          bindinput="onFormInput"
          placeholder="e.g. 128.00"
        />

        <view class="field-label">Extra refund points (optional)</view>
        <input
          class="input"
          type="number"
          data-id="{{item.id}}"
          data-field="refundPoints"
          value="{{forms[item.id].refundPoints || ''}}"
          bindinput="onFormInput"
          placeholder="e.g. 20"
        />

        <view class="field-label">Review note (optional)</view>
        <input
          class="input"
          data-id="{{item.id}}"
          data-field="remark"
          value="{{forms[item.id].remark || ''}}"
          bindinput="onFormInput"
          placeholder="Write handling note"
        />

        <view class="action-row">
          <view class="mini-btn reject-btn" data-id="{{item.id}}" data-status="1" bindtap="review">
            {{reviewing ? "Processing..." : "Reject"}}
          </view>
          <view class="mini-btn accept-btn" data-id="{{item.id}}" data-status="2" bindtap="review">
            {{reviewing ? "Processing..." : "Accept"}}
          </view>
        </view>
      </block>
    </view>
  </block>

  <view wx:else class="empty">No objection records.</view>
</view>

