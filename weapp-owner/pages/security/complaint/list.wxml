<view class="section">
  <view class="hero security-hero">
    <view class="hero-title">Complaint Feedback</view>
    <view class="hero-desc">View owner complaints and submit replies.</view>
  </view>

  <view class="item">
    <view class="field-label">Status</view>
    <picker class="picker" mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
      <view class="picker-trigger input">
        {{statusValue === '' ? 'All' : (statusValue === '1' ? 'Pending' : 'Replied')}}
      </view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="empty">Loading...</view>

  <block wx:elif="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="row-between">
        <view class="item-title">#{{item.id}} {{item.title || "Complaint"}}</view>
        <view class="status-tag">{{item.statusText}}</view>
      </view>
      <view class="meta">User: {{item.userId}}</view>
      <view class="meta">Type: {{item.type}}</view>
      <view class="meta">Created: {{item.createTime || "--"}}</view>
      <view class="item-desc">{{item.content || "--"}}</view>

      <block wx:if="{{item.reply}}">
        <view class="field-label">Reply</view>
        <view class="item-desc">{{item.reply}}</view>
        <view class="meta">Replied at: {{item.replyTime || "--"}}</view>
      </block>

      <block wx:else>
        <view class="field-label">Reply content</view>
        <textarea
          class="input textarea"
          data-id="{{item.id}}"
          bindinput="onReplyInput"
          value="{{replyDrafts[item.id] || ''}}"
          placeholder="Input reply text"
        ></textarea>
        <view class="btn feedback-btn" data-id="{{item.id}}" bindtap="submitReply">
          {{replying ? "Submitting..." : "Submit reply"}}
        </view>
      </block>
    </view>
  </block>

  <view wx:else class="empty">No complaints.</view>
</view>

