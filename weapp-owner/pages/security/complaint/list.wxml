<view class="section">
  <view class="hero security-hero">
    <view class="hero-title">投诉建议反馈</view>
  </view>

  <view class="item">
    <view class="field-label">状态筛选</view>
    <picker class="picker" mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
      <view class="picker-trigger input">
        {{statusValue === '' ? '全部' : (statusValue === '1' ? '待回复' : '已回复')}}
      </view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="row-between">
        <view class="item-title">#{{item.id}} {{item.title || "投诉单"}}</view>
        <view class="status-tag">{{item.statusText}}</view>
      </view>
      <view class="analysis-row">
        <view class="analysis-tag {{item.riskClass}}">风险：{{item.riskText}}</view>
        <view class="analysis-tag {{item.sentimentClass}}">情感：{{item.sentimentText}}</view>
        <view class="analysis-score">分数：{{item.sentimentScoreText}}</view>
      </view>
      <view class="meta">业主ID：{{item.userId}}</view>
      <view class="meta">类型：{{item.type || "--"}}</view>
      <view class="meta">提交时间：{{item.createTime || "--"}}</view>
      <view class="meta">分析时间：{{item.analyzedAtText}}</view>
      <view class="item-desc">{{item.content || "--"}}</view>

      <block wx:if="{{item.reply}}">
        <view class="field-label">回复内容</view>
        <view class="item-desc">{{item.reply}}</view>
        <view class="meta">回复时间：{{item.replyTime || "--"}}</view>
      </block>

      <block wx:else>
        <view class="field-label">填写回复</view>
        <textarea
          class="input textarea"
          data-id="{{item.id}}"
          bindinput="onReplyInput"
          value="{{replyDrafts[item.id] || ''}}"
          placeholder="请输入回复内容"
        ></textarea>
        <view class="btn feedback-btn" data-id="{{item.id}}" bindtap="submitReply">
          {{replying ? "提交中..." : "提交回复"}}
        </view>
      </block>
    </view>
  </block>

  <view wx:else class="empty">暂无投诉记录</view>
</view>
