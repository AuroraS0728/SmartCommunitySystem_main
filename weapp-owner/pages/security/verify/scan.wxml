<view class="section">
  <view class="hero security-hero">
    <view class="hero-title">门禁扫码核验</view>
  </view>

  <view class="item">
    <view class="row-between">
      <view class="item-title">相机权限</view>
      <view class="status-tag {{cameraAuthorized ? 'ok' : ''}}">
        {{cameraAuthorized ? '已授权' : '未授权'}}
      </view>
    </view>
    <view class="item-desc">安防端需要申请手机相机权限，用于门禁二维码扫描与核验。</view>
    <view class="action-row">
      <view class="mini-btn" bindtap="requestCameraPermission">申请相机权限</view>
      <view class="mini-btn mini-btn-plain" bindtap="checkCameraPermission">刷新权限状态</view>
    </view>
  </view>

  <view class="item">
    <view class="item-title">扫码核验</view>
    <view class="item-desc">请将访客二维码放入扫描框内，识别后自动核验。</view>
    <view class="scan-box">
      <camera
        class="scan-camera"
        mode="scanCode"
        device-position="back"
        flash="off"
        bindscancode="onCameraScan"
        binderror="onCameraError"
      ></camera>
      <view class="scan-frame"></view>
      <view class="scan-status">{{verifying ? '核验中...' : '对准二维码自动核验'}}</view>
    </view>
    <view wx:if="{{cameraError}}" class="meta error-text">{{cameraError}}</view>
    <textarea
      class="input textarea"
      placeholder="请输入扫码内容"
      value="{{scanText}}"
      bindinput="onScanTextInput"
    />
    <view class="meta">识别结果：{{token || '--'}}</view>
    <view class="action-row">
      <view class="mini-btn mini-btn-plain" bindtap="readFromClipboard">从剪贴板读取</view>
      <view class="mini-btn mini-btn-plain" bindtap="simulateScanVerify">手动核验</view>
    </view>
  </view>

  <view class="item" wx:if="{{result}}">
    <view class="item-title">核验结果</view>
    <view class="result {{resultType === 'success' ? 'result-success' : 'result-error'}}">{{result}}</view>
  </view>
</view>
