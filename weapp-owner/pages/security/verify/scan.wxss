.security-hero {
  background: linear-gradient(135deg, #92400e, #b45309);
}

.action-row {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.mini-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: #2563eb;
}

.mini-btn-plain {
  color: #1e40af;
  background: #dbeafe;
}

.scan-box {
  margin-top: 24rpx;
  position: relative;
  width: 100%;
  height: 460rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #111827;
}

.scan-camera {
  width: 100%;
  height: 100%;
}

.scan-frame {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 320rpx;
  height: 320rpx;
  transform: translate(-50%, -50%);
  border: 4rpx solid #22c55e;
  border-radius: 8rpx;
  box-shadow: 0 0 0 999rpx rgba(15, 23, 42, 0.32);
  pointer-events: none;
}

.scan-status {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
  pointer-events: none;
}

.error-text {
  color: #b91c1c;
}

.result {
  margin-top: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.status-tag.ok {
  border-color: #86efac;
  background: #dcfce7;
  color: #166534;
}

.result-success {
  color: #047857;
}

.result-error {
  color: #b91c1c;
}
