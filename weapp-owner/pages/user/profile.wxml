<view class="section">
  <view class="hero">
    <view class="hero-title">个人中心</view>
    <view class="hero-desc">查看个人服务记录和积分资产</view>
  </view>

  <view class="item">
    <view class="row-between">
      <view class="item-title">当前积分</view>
      <view class="status-tag">{{ points }}</view>
    </view>
    <view class="item-desc">1 积分 = 1 元人民币</view>
    <navigator class="link" url="/pages/points/detail/index">查看积分明细 ></navigator>
  </view>

  <navigator class="item nav-item" url="/pages/repair/list">
    <view class="nav-body">
      <view class="item-title">我的报修</view>
      <view class="item-desc">查看历史工单和处理进度</view>
    </view>
    <view class="nav-arrow">></view>
  </navigator>

  <navigator class="item nav-item" url="/pages/notice/list">
    <view class="nav-body">
      <view class="item-title">公告中心</view>
      <view class="item-desc">回看社区历史公告信息</view>
    </view>
    <view class="nav-arrow">></view>
  </navigator>

  <view class="btn logout-btn" bindtap="onLogout">退出登录</view>
</view>
