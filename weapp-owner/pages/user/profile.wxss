.member-page {
  padding-bottom: 40rpx;
}

.guest-card {
  padding: 28rpx;
}

.guest-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.guest-login-btn {
  padding: 0 28rpx;
}

.mini-square {
  min-width: 124rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #eef2ff;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.member-hero {
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, #fde8d3, #fce1c1);
}

.member-hero .hero-title {
  color: #b8860b;
}

.member-hero .hero-desc {
  color: #9b9b9b;
}

.member-hero .meta {
  color: #b8860b;
}

.avatar-wrap {
  width: 92rpx;
  height: 92rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 2rpx solid #e3d2b5;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff5e6;
  color: #b8860b;
  font-size: 36rpx;
  font-weight: 600;
}

.member-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 26rpx;
}

.metric {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5e2df;
}

.metric-value {
  color: #2a6dff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.metric-label {
  margin-top: 10rpx;
  color: #9b9b9b;
  font-size: 24rpx;
}

.metric-sub {
  margin-top: 8rpx;
  color: #9b9b9b;
  font-size: 22rpx;
}

.profile-editor {
  padding: 28rpx;
}

.profile-head {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-row,
.profile-field {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4a4a4a;
  font-size: 28rpx;
  border-top: 1rpx solid #f0efed;
}

.profile-input {
  width: 220rpx;
  min-height: 64rpx;
  text-align: right;
  color: #222;
  font-size: 28rpx;
}

.profile-save {
  margin-top: 18rpx;
}

.nav-leading {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #e5484d;
  color: #fff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  margin-right: 16rpx;
}
