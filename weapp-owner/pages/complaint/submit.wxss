.complaint-card .item-title {
  max-width: 430rpx;
}

.reply-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.reply-box .field-label {
  margin-bottom: 8rpx;
}

.reply-content {
  color: #4a4a4a;
}

.satisfaction-box {
  margin-top: 18rpx;
}

.rating-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rating-btn {
  min-width: 88rpx;
  height: 48rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
  color: #0f766e;
  background: #ccfbf1;
}

.rating-disabled {
  color: #94a3b8;
  background: #e2e8f0;
}

.satisfaction-done {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #166534;
  background: #dcfce7;
}
