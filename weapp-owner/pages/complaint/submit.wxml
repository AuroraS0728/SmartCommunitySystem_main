<view class="section">
  <view class="hero">
    <view class="hero-title">投诉建议</view>
    <view class="hero-desc">欢迎反馈社区服务问题，我们会尽快处理。</view>
  </view>

  <view class="item">
    <view class="field-label">主题</view>
    <input class="input" value="{{title}}" placeholder="请输入投诉主题" bindinput="onTitle" />

    <view class="field-label">内容</view>
    <textarea class="input textarea" value="{{content}}" placeholder="请输入详细内容" bindinput="onContent"></textarea>

    <view class="btn" bindtap="submit">{{submitting ? '提交中...' : '提交反馈'}}</view>
  </view>

  <view class="group-title">我的投诉建议</view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="item complaint-card">
      <view class="row-between">
        <view class="item-title">{{item.title || '投诉建议'}}</view>
        <view class="status-tag">{{item.statusText}}</view>
      </view>
      <view class="meta">提交时间：{{item.createTimeText || '--'}}</view>
      <view class="item-desc">{{item.content || '--'}}</view>

      <view class="reply-box">
        <view class="field-label">物业反馈</view>
        <view wx:if="{{item.reply}}" class="item-desc reply-content">{{item.reply}}</view>
        <view wx:if="{{item.reply}}" class="meta">反馈时间：{{item.replyTimeText || '--'}}</view>
        <view wx:else class="item-desc">物业暂未反馈，请耐心等待。</view>
      </view>
    </view>
  </block>

  <view wx:else class="empty">暂无投诉建议记录</view>
</view>
