.board-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 600;
}

.chip.active {
  border-color: #2563eb;
  background: #2563eb;
  color: #fff;
}
