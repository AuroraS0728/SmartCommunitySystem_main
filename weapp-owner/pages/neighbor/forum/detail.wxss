.title {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}

.badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge.top {
  color: #b45309;
  background: #fef3c7;
}

.badge.essence {
  color: #047857;
  background: #d1fae5;
}

.meta-line {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}

.content {
  margin-top: 18rpx;
  color: #334155;
  font-size: 27rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-word;
}

.action-row {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.small-btn {
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dbe3ef;
  background: #f8fafc;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}

.small-btn.primary {
  border-color: #2563eb;
  background: #eff6ff;
  color: #2563eb;
}

.small-btn.danger {
  border-color: #ef4444;
  background: #fef2f2;
  color: #ef4444;
}

.small-empty {
  margin-bottom: 0;
  padding: 40rpx 28rpx;
}

.comment-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #f8fafc;
}

.comment-user {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 600;
}

.comment-time {
  color: #94a3b8;
  font-size: 22rpx;
}

.comment-content {
  margin-top: 10rpx;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.comment-action {
  margin-top: 12rpx;
  display: flex;
  gap: 18rpx;
}

.comment-link {
  color: #2563eb;
  font-size: 24rpx;
}

.comment-link.danger {
  color: #ef4444;
}

.no-gap {
  margin-bottom: 0;
}

.reply-tip {
  color: #2563eb;
  font-size: 23rpx;
}

.comment-input {
  margin-top: 20rpx;
  margin-bottom: 0;
  min-height: 220rpx;
}
