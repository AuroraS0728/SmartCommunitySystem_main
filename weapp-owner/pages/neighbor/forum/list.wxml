<view class="section">
  <view class="hero">
    <view class="hero-title">社区论坛</view>
    <view class="hero-desc">支持按板块筛选、发帖、评论和点赞互动</view>
  </view>

  <view class="item search-card">
    <input
      class="input search-input"
      value="{{keyword}}"
      placeholder="搜索帖子标题或内容"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <view class="btn search-btn" bindtap="onSearch">搜索</view>
    <view class="btn post-btn" bindtap="goPost">发布帖子</view>
  </view>

  <view class="item filter-card">
    <view class="chip-row">
      <view
        wx:for="{{boardOptions}}"
        wx:key="label"
        class="chip {{String(board) === String(item.value) ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onBoardTap"
      >
        {{item.label}}
      </view>
    </view>

    <view class="row-between mine-row">
      <view class="mine-label">仅看我的帖子</view>
      <switch checked="{{mine}}" color="#2563eb" bindchange="onMineSwitch" />
    </view>

    <view class="row-between sort-row" bindtap="onSortTap">
      <view class="sort-label">排序：{{sortLabel}}</view>
      <view class="sort-arrow">切换 ></view>
    </view>
  </view>

  <block wx:if="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="item post-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="row-between">
        <view class="post-title">{{item.title}}</view>
        <view wx:if="{{item.isTop == 1}}" class="badge top">置顶</view>
        <view wx:elif="{{item.isEssence == 1}}" class="badge essence">精华</view>
      </view>
      <view class="post-preview">{{item.preview || "暂无内容"}}</view>
      <view class="post-meta">
        <text>{{item.boardText}}</text>
        <text> · 浏览 {{item.viewCount || 0}}</text>
        <text> · 点赞 {{item.likeCnt || 0}}</text>
        <text> · 评论 {{item.replyCnt || 0}}</text>
      </view>
      <view class="post-time">{{item.timeText}}</view>
    </view>
  </block>

  <view wx:else class="empty">暂无论坛帖子</view>

  <view wx:if="{{loading}}" class="meta">加载中...</view>
  <view wx:else-if="{{!hasMore && list.length}}" class="meta">没有更多了</view>
</view>
