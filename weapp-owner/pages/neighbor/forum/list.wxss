.search-card {
  margin-bottom: 24rpx;
}

.search-input {
  margin-bottom: 20rpx;
}

.search-btn {
  margin-top: 0;
}

.post-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #0f766e, #0d9488);
}

.filter-card {
  margin-bottom: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 600;
}

.chip.active {
  border-color: #2563eb;
  background: #2563eb;
  color: #fff;
}

.mine-row {
  margin-top: 18rpx;
}

.mine-label {
  color: #334155;
  font-size: 26rpx;
}

.sort-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef2f7;
}

.sort-label {
  color: #0f172a;
  font-size: 26rpx;
}

.sort-arrow {
  color: #2563eb;
  font-size: 24rpx;
}

.post-card {
  margin-bottom: 24rpx;
}

.post-title {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge.top {
  color: #b45309;
  background: #fef3c7;
}

.badge.essence {
  color: #047857;
  background: #d1fae5;
}

.post-preview {
  margin-top: 12rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.7;
}

.post-meta,
.post-time {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}
