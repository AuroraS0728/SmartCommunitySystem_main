<view class="section">
  <view class="hero">
    <view class="hero-title">{{id ? "重新上传" : "发布闲置"}}</view>
  </view>

  <view class="item">
    <view class="field-label">商品标题</view>
    <input class="input" value="{{title}}" maxlength="60" placeholder="例如：九成新空气炸锅" bindinput="onTitleInput" />

    <view class="field-label">分类</view>
    <view class="category-row">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="chip {{category === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onCategoryTap"
      >
        {{item.label}}
      </view>
    </view>

    <view class="field-label">价格（元）</view>
    <input class="input" type="digit" value="{{price}}" placeholder="0 表示面议" bindinput="onPriceInput" />

    <view class="field-label">联系方式</view>
    <input class="input" value="{{contact}}" maxlength="80" placeholder="手机号 / 微信号" bindinput="onContactInput" />

    <view class="field-label">商品描述</view>
    <textarea
      class="input textarea"
      value="{{description}}"
      maxlength="300"
      placeholder="描述成色、使用情况、交易方式等"
      bindinput="onDescInput"
    />

    <view class="field-label">商品图片（最多3张）</view>
    <view class="image-grid">
      <view wx:for="{{imageList}}" wx:key="*this" class="image-item">
        <image class="image" src="{{item.displayUrl}}" mode="aspectFill" data-url="{{item.displayUrl}}" bindtap="previewImage" />
        <view class="remove" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
      <view wx:if="{{imageList.length < 3}}" class="image-add" bindtap="chooseImage">+ 添加</view>
    </view>

    <view class="btn" bindtap="onSubmit">{{submitting ? "提交中..." : (id ? "重新提交审核" : "发布商品")}}</view>
  </view>
</view>
