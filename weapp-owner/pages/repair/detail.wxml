<view class="section">
  <view class="hero">
    <view class="hero-title">工单详情</view>
    <view class="hero-desc">提交报修 -> 派单 -> 验码 -> 服务 -> 双方确认 -> 评价</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{detail && detail.order}}">
    <view class="item">
      <view class="item-title">{{detail.order.category || "报修工单"}}</view>
      <view class="item-desc">{{detail.order.description || "暂无详细描述"}}</view>
      <view class="meta">状态：{{detail.statusText || detail.order.status}}</view>
      <view class="meta">工单ID：{{detail.order.id}}</view>
      <view class="meta" wx:if="{{detail.order.assignee}}">维修人员ID：{{detail.order.assignee}}</view>
    </view>

    <view class="item" wx:if="{{detail.repairFeeBill}}">
      <view class="item-title">维修费用账单</view>
      <view class="meta">账单ID：{{detail.repairFeeBill.id}}</view>
      <view class="meta">金额：{{detail.repairFeeBill.amount}} 元</view>
      <view class="meta">需支付积分：{{detail.repairFeeNeedPoints}}</view>
      <view class="meta">状态：{{detail.repairFeeBillStatusText}}</view>
      <view class="meta">截止时间：{{detail.repairFeeBill.dueDate || '--'}}</view>
      <view wx:if="{{detail.repairFeeBill.status !== 1}}" class="btn" bindtap="payRepairFee">
        {{payingRepairFee ? "支付中..." : "使用积分支付维修费用"}}
      </view>
    </view>

    <view class="item" wx:if="{{detail.verifyCode}}">
      <view class="item-title">现场验证码</view>
      <view class="item-desc code-value">{{detail.verifyCode}}</view>
      <view class="meta">维修人员上门后，请当面提供验证码进行核验。</view>
    </view>

    <view class="item">
      <view class="item-title">结束确认</view>
      <view class="meta">业主确认：{{detail.ownerFinishConfirmed ? "已确认" : "未确认"}}</view>
      <view class="meta">维修端确认：{{detail.workerFinishConfirmed ? "已确认" : "未确认"}}</view>
      <view class="btn" wx:if="{{detail.canOwnerFinish}}" bindtap="confirmFinish">
        {{confirmingFinish ? "提交中..." : "确认服务结束"}}
      </view>
      <view class="meta" wx:if="{{!detail.canOwnerFinish && detail.order.status === 2}}">
        需业主与维修端都点击“结束”后，系统才进入完单结算流程。
      </view>
    </view>

    <view class="item" wx:if="{{detail.evaluation}}">
      <view class="item-title">已提交评价</view>
      <view class="rating-line">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{detail.evaluation.rating >= item ? 'active' : ''}}">★</text>
      </view>
      <view class="item-desc">{{detail.evaluation.comment || "未填写评价内容"}}</view>
    </view>

    <view class="item" wx:if="{{detail.canEvaluate}}">
      <view class="item-title">服务评价</view>
      <view class="rating-line">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="onRatingTap"
          class="star {{rating >= item ? 'active' : ''}}"
        >
          ★
        </text>
      </view>
      <textarea
        class="input textarea"
        value="{{comment}}"
        placeholder="可填写服务体验，如响应速度、处理质量等"
        bindinput="onCommentInput"
      ></textarea>
      <view class="btn" bindtap="submitEvaluation">{{evaluating ? "提交中..." : "提交评价"}}</view>
    </view>
  </block>

  <view wx:else class="empty">未找到工单详情</view>
</view>
