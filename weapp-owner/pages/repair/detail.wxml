<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <view wx:elif="{{detail.order}}">
    <view class="section">
      <view class="hero">
        <view class="hero-title">{{detail.order.category || "报修工单"}}</view>
        <view class="hero-subtitle">{{detail.order.description || "暂无详细描述"}}</view>
      </view>

      <view class="item">
        <view class="row-between row-start">
          <view>
            <view class="item-title">工单状态</view>
            <view class="item-desc">当前处理进度</view>
          </view>
          <view class="status-tag {{detail.statusClass}}">{{detail.statusText || detail.order.status}}</view>
        </view>
      </view>

      <view class="item">
        <view class="item-title">工单编号</view>
        <view class="item-desc">{{detail.order.id}}</view>
      </view>
    </view>

    <view class="section" wx:if="{{detail.canShowVerifyCode || detail.verifyCode}}">
      <view class="section-title">上门核验</view>
      <view class="item">
        <view class="item-title">现场验证码</view>
        <view wx:if="{{detail.verifyCode}}" class="item-desc code-value">{{detail.verifyCode}}</view>
        <view wx:else class="item-desc">{{loadingVerifyCode ? "验证码加载中..." : "暂无验证码"}}</view>
        <view class="meta">{{detail.verifyCodeHint}}</view>
        <view class="link" bindtap="fetchVerifyCode">刷新验证码</view>
      </view>
    </view>

    <view class="section" wx:elif="{{detail.canShowVerifyCodePending}}">
      <view class="section-title">上门核验</view>
      <view class="item">
        <view class="item-title">现场验证码</view>
        <view class="item-desc">派单后自动生成</view>
        <view class="meta">{{detail.verifyCodeHint}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">服务过程</view>

      <view class="item">
        <view class="item-title">服务开始时间</view>
        <view class="item-desc">{{detail.order.serviceStartTime || "--"}}</view>
      </view>

      <view class="item">
        <view class="item-title">服务结束时间</view>
        <view class="item-desc">{{detail.order.serviceEndTime || "--"}}</view>
      </view>

      <view class="item">
        <view class="item-title">服务时长</view>
        <view class="item-desc">{{detail.order.serviceDurationMinutes || 0}} 分钟</view>
      </view>
    </view>

    <view class="section" wx:if="{{detail.beforeImages && detail.beforeImages.length}}">
      <view class="section-title">服务前图片</view>
      <view class="image-grid">
        <image
          wx:for="{{detail.beforeImages}}"
          wx:key="*this"
          class="repair-image"
          src="{{item}}"
          mode="aspectFill"
        />
      </view>
    </view>

    <view class="section" wx:if="{{detail.afterImages && detail.afterImages.length}}">
      <view class="section-title">服务后图片</view>
      <view class="image-grid">
        <image
          wx:for="{{detail.afterImages}}"
          wx:key="*this"
          class="repair-image"
          src="{{item}}"
          mode="aspectFill"
        />
      </view>
    </view>

    <view class="section" wx:if="{{detail.feeDetails && detail.feeDetails.length}}">
      <view class="section-title">维修费用明细</view>

      <view wx:for="{{detail.feeDetails}}" wx:key="id" class="item">
        <view class="item-title">费用明细</view>
        <view class="item-desc">
          技术费 {{item.techFee || 0}} 元，材料费 {{item.materialFee || 0}} 元，
          高空费 {{item.highAltitudeFee || 0}} 元，其他 {{item.otherFee || 0}} 元，
          小计 {{item.totalAmount || 0}} 元
        </view>
      </view>

      <view class="item">
        <view class="item-title">费用合计</view>
        <view class="item-desc">{{detail.feeTotal || 0}} 元</view>
      </view>
    </view>

    <view class="section" wx:if="{{detail.repairFeeBill}}">
      <view class="section-title">维修费用账单</view>

      <view class="item">
        <view class="item-title">账单金额</view>
        <view class="item-desc">{{detail.repairFeeBill.amount}} 元</view>
      </view>

      <view class="item">
        <view class="item-title">支付积分</view>
        <view class="item-desc">{{detail.repairFeeNeedPoints}} 积分</view>
      </view>

      <view class="item">
        <view class="item-title">账单状态</view>
        <view class="item-desc">{{detail.repairFeeBillStatusText}}</view>
      </view>

      <view class="item">
        <view class="item-title">截止时间</view>
        <view class="item-desc">{{detail.repairFeeBill.dueDate || "--"}}</view>
      </view>

      <button
        wx:if="{{detail.repairFeeBill.status != 1}}"
        class="primary-btn"
        bindtap="payRepairFee"
      >
        {{payingRepairFee ? "支付中..." : "使用积分支付维修费用"}}
      </button>

      <view wx:if="{{detail.repairFeeBill.status != 1}}" class="objection-box">
        <textarea
          placeholder="如费用不合理，请填写费用异议原因"
          value="{{objectionReason}}"
          bindinput="onObjectionReasonInput"
        />
        <button class="ghost-btn" bindtap="submitFeeObjection">
          {{submittingObjection ? "提交中..." : "提交费用异议"}}
        </button>
      </view>
    </view>

    <view class="section" wx:if="{{detail.objections && detail.objections.length}}">
      <view class="section-title">费用异议记录</view>
      <view wx:for="{{detail.objections}}" wx:key="id" class="item">
        <view class="item-title">异议记录</view>
        <view class="item-desc">
          状态：{{item.status}}，保证金：{{item.depositPoints}}，退款：{{item.refundPoints || 0}}
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{detail.canOwnerFinish && detail.workerFinishConfirmed && !detail.ownerFinishConfirmed}}">
      <view class="section-title">服务结束确认</view>

      <view class="item">
        <view class="item-title">工人确认状态</view>
        <view class="item-desc">工人已确认完工</view>
      </view>

      <view class="item">
        <view class="item-title">业主确认状态</view>
        <view class="item-desc">未确认</view>
      </view>

      <view class="meta">请在确认服务内容、服务图片和维修费用无误后，再确认服务结束。</view>

      <button class="primary-btn" bindtap="confirmFinish">
        {{confirmingFinish ? "提交中..." : "确认服务结束"}}
      </button>
    </view>

    <view class="section" wx:if="{{detail.ownerFinishConfirmed}}">
      <view class="section-title">服务结束确认</view>

      <view class="item">
        <view class="item-title">确认结果</view>
        <view class="item-desc">业主已确认服务结束</view>
      </view>

      <view class="item">
        <view class="item-title">确认时间</view>
        <view class="item-desc">{{detail.ownerFinishTime || "--"}}</view>
      </view>
    </view>

    <view class="section" wx:if="{{detail.canEvaluate}}">
      <view class="section-title">服务评价</view>
      <view class="rating-line">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="onRatingTap"
          class="star {{rating >= item ? 'active' : ''}}"
        >★</text>
      </view>
      <textarea
        placeholder="请输入评价内容"
        value="{{comment}}"
        bindinput="onCommentInput"
      />
      <button class="primary-btn" bindtap="submitEvaluation">
        {{evaluating ? "提交中..." : "提交评价"}}
      </button>
    </view>

    <view class="section" wx:if="{{detail.evaluation && !detail.canEvaluate}}">
      <view class="section-title">已提交评价</view>
      <view class="item">
        <view class="item-title">评分</view>
        <view class="item-desc">{{detail.evaluation.rating}} 星</view>
      </view>
      <view class="item">
        <view class="item-title">评价内容</view>
        <view class="item-desc">{{detail.evaluation.comment || "未填写评价内容"}}</view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">未找到工单详情</view>
</view>
