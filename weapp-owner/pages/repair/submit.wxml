<view class="section">
  <view class="hero">
    <view class="hero-title">报修 / 家政提交</view>
  </view>

  <view class="item">
    <view wx:if="{{facilityId}}" class="facility-card">
      <view class="row-between">
        <view class="item-title">关联设施</view>
        <view class="link" bindtap="clearFacility">取消关联</view>
      </view>
      <view class="item-desc">设施名称：{{ facilityName || '--' }}</view>
      <view wx:if="{{facilityLocation}}" class="item-desc">设施位置：{{ facilityLocation }}</view>
    </view>

    <view class="field-label">服务类型</view>
    <view class="type-row">
      <view class="type-chip {{serviceType === 1 ? 'active' : ''}}" data-type="1" bindtap="onServiceTypeChange">维修服务</view>
      <view class="type-chip {{serviceType === 2 ? 'active' : ''}}" data-type="2" bindtap="onServiceTypeChange">家政服务</view>
    </view>

    <view class="field-label">服务大类</view>
    <view class="category-grid">
      <view
        wx:for="{{majorList}}"
        wx:key="*this"
        class="category-chip {{selectedMajor === item ? 'active' : ''}}"
        data-major="{{item}}"
        bindtap="onMajorChange"
      >
        {{item}}
      </view>
    </view>

    <view class="field-label">细分类型</view>
    <view class="category-grid">
      <view
        wx:for="{{subTypeList}}"
        wx:key="*this"
        class="category-chip {{!useCustomSubType && selectedSubType === item ? 'active' : ''}}"
        data-sub-type="{{item}}"
        bindtap="onSubTypeChange"
      >
        {{item}}
      </view>
    </view>

    <view class="category-custom-link" bindtap="onCustomSwitch">自定义细分类型</view>
    <input
      wx:if="{{useCustomSubType}}"
      class="input"
      value="{{customSubType}}"
      placeholder="请输入自定义细分类型"
      maxlength="30"
      bindinput="onCustomSubTypeInput"
    />

    <view class="field-label">上门日期</view>
    <picker mode="date" value="{{appointmentDate}}" bindchange="onDateChange">
      <view class="date-picker">{{appointmentDate || '请选择上门日期'}}</view>
    </picker>

    <view class="field-label">上门时间段</view>
    <view wx:if="{{loadingSlots}}" class="meta">时段加载中...</view>
    <view class="slot-grid">
      <view
        wx:for="{{slotList}}"
        wx:key="code"
        class="slot-chip {{selectedSlot === item.code ? 'active' : ''}} {{!item.available ? 'disabled' : ''}}"
        data-code="{{item.code}}"
        data-available="{{item.available}}"
        bindtap="onSlotTap"
      >
        <view class="slot-title">{{item.label}}</view>
        <view class="slot-meta">{{item.available ? ('可预约 ' + item.availableCount + ' 人') : '暂无人员'}}</view>
      </view>
    </view>

    <view class="field-label">问题描述</view>
    <textarea
      class="input textarea"
      value="{{description}}"
      placeholder="请描述问题现象、上门注意事项、位置等信息"
      bindinput="onDesc"
    ></textarea>

    <view class="btn" bindtap="submitRepair">{{submitting ? '提交中...' : '提交工单'}}</view>
  </view>
</view>
