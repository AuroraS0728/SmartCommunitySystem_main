.time-row {
  margin-bottom: 26rpx;
  display: flex;
  gap: 18rpx;
}

.picker {
  min-width: 220rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dbe3ef;
  background: #f8fafc;
}

.validity-row {
  margin-bottom: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  color: #334155;
  background: #ffffff;
  font-size: 24rpx;
}

.chip-active {
  border-color: #2563eb;
  color: #1d4ed8;
  background: #eff6ff;
}

.code-line {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  font-family: Consolas, Monaco, monospace;
}

.action-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.mini-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: #2563eb;
}

.mini-btn-plain {
  color: #1e40af;
  background: #dbeafe;
}

.mini-btn-safe {
  color: #065f46;
  background: #d1fae5;
}

.mini-share {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #065f46;
  background: #d1fae5;
}

.mini-share::after {
  border: none;
}

.invite-row {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 12rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx dashed #e2e8f0;
}

.invite-left {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
}

.invite-mid {
  color: #1d4ed8;
  font-size: 28rpx;
  font-family: Consolas, Monaco, monospace;
}

.invite-right {
  text-align: right;
}

.countdown {
  color: #0f172a;
  font-size: 26rpx;
}

.status {
  color: #64748b;
  font-size: 22rpx;
}

.invite-actions {
  grid-column: 1 / span 3;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.history-row {
  margin-top: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.history-name {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
}

.history-meta {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

.notify-row {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.empty-small {
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
}
