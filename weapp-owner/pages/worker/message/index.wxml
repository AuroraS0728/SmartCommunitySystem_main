<view class="section">
  <view wx:if="{{loading}}" class="empty">消息加载中...</view>

  <block wx:else>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="item nav-item message-item"
      bindtap="openTaskList"
      data-status="{{item.status}}"
      data-message-id="{{item.messageId || ''}}"
    >
      <view class="nav-body">
        <view class="message-title-row">
          <view class="item-title">{{item.title}}</view>
          <view wx:if="{{item.messageId && item.isRead === 0}}" class="dot"></view>
        </view>
        <view class="item-desc">{{item.desc}}</view>
        <view wx:if="{{item.time}}" class="meta">{{item.time}}</view>
      </view>
      <view wx:if="{{!item.messageId}}" class="nav-arrow">></view>
    </view>
  </block>
</view>
