<view class="section">
  <view wx:if="{{loading}}" class="empty">消息加载中...</view>

  <block wx:else>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="item nav-item message-item"
      bindtap="openTaskList"
      data-status="{{item.status}}"
    >
      <view class="nav-body">
        <view class="item-title">{{item.title}}</view>
        <view class="item-desc">{{item.desc}}</view>
      </view>
      <view class="nav-arrow">></view>
    </view>
  </block>
</view>
