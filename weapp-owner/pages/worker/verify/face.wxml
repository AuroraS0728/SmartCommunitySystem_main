<view class="section">
  <view class="hero worker-hero">
    <view class="hero-title">上门人脸实时检测</view>
  </view>

  <view class="item">
    <view class="item-title">当前信息</view>
    <view class="meta">工人ID：{{workerId || "--"}}</view>
    <view class="meta">工单ID：{{orderId || "--"}}</view>
  </view>

  <view class="item">
    <view class="item-title">实时取帧区域</view>
    <camera id="liveCamera" class="live-camera" device-position="front" flash="off" />
    <view class="meta">请正对镜头，保持1-2秒稳定</view>
  </view>

  <view class="item">
    <view class="item-title">检测状态</view>
    <view class="item-desc">{{statusText}}</view>
    <view class="meta">检测次数：{{attempts}}</view>
    <view class="meta">连续通过次数：{{passCount}}</view>
    <view class="meta">活体：{{livenessLabel}}</view>
    <view class="meta">相似度：{{score.toFixed(4)}} / 阈值：{{threshold.toFixed(4)}}</view>
    <view wx:if="{{pendingWorkerIds.length}}" class="meta">
      待通过工人：{{pendingWorkerIds.join(",")}}
    </view>
    <view wx:if="{{resultRows.length}}" class="meta-list">
      <view wx:for="{{resultRows}}" wx:key="*this" class="meta">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{!running}}" class="btn worker-btn" bindtap="startLiveVerify">开始实时检测</view>
  <view wx:else class="btn worker-btn danger-btn" bindtap="stopLiveVerify">停止检测</view>
</view>
