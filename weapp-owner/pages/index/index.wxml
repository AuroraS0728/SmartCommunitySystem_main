<view class="section">
  <view class="hero home-hero">
    <view class="hero-title">首页</view>
    <view class="hero-desc">欢迎回来，{{ (user && user.nickname) || "业主" }}</view>
    <view class="meta">当前积分：{{ points }}</view>
  </view>

  <view class="item quick-grid">
    <view class="quick" bindtap="goFeeBills">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/fee.png" mode="aspectFit" />
      </view>
      <view class="item-title">物业缴费</view>
      <view class="item-desc">物业账单缴费</view>
    </view>
    <view class="quick" bindtap="goInvite">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/invite.png" mode="aspectFit" />
      </view>
      <view class="item-title">访客邀请</view>
      <view class="item-desc">创建访客邀请码</view>
    </view>
    <view class="quick" bindtap="goRepair">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/repair.png" mode="aspectFit" />
      </view>
      <view class="item-title">报事报修</view>
      <view class="item-desc">提交维修工单</view>
    </view>
    <view class="quick" bindtap="goRentSale">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/rent-sale.png" mode="aspectFit" />
      </view>
      <view class="item-title">闲置交易</view>
      <view class="item-desc">发布与查看闲置物品</view>
    </view>
  </view>

  <view wx:if="{{recommendations.length > 0}}" class="recommend-section">
    <view class="group-title">为您推荐</view>
    <view
      wx:for="{{recommendations}}"
      wx:key="serviceId"
      class="item recommend-card"
    >
      <view class="recommend-main">
        <view class="recommend-body">
          <view class="item-title">{{item.serviceName}}</view>
          <view class="item-desc">{{item.reason}}</view>
        </view>
        <view class="recommend-price">￥{{item.price}}</view>
      </view>
      <view class="recommend-action" data-id="{{item.serviceId}}" bindtap="openRecommendation">查看详情</view>
    </view>
  </view>
</view>
