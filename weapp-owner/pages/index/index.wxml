<view class="section">
  <view class="hero home-hero">
    <view class="hero-title">首页</view>
    <view class="hero-desc">欢迎回来，{{ (user && user.nickname) || "业主" }}</view>
    <view class="meta">当前积分：{{ points }}</view>
  </view>

  <swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" duration="500">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" data-item="{{item}}" bindtap="tapBanner">
        <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="banner-mask">
          <view class="banner-title">{{item.title}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="item quick-grid">
    <view class="quick" bindtap="goFeeBills">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/fee.png" mode="aspectFit" />
      </view>
      <view class="item-title">物业缴费</view>
      <view class="item-desc">物业账单缴费</view>
    </view>
    <view class="quick" bindtap="goInvite">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/invite.png" mode="aspectFit" />
      </view>
      <view class="item-title">访客邀请</view>
      <view class="item-desc">创建访客邀请码</view>
    </view>
    <view class="quick" bindtap="goRepair">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/repair.png" mode="aspectFit" />
      </view>
      <view class="item-title">报事报修</view>
      <view class="item-desc">提交维修工单</view>
    </view>
    <view class="quick" bindtap="goRentSale">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/rent-sale.png" mode="aspectFit" />
      </view>
      <view class="item-title">闲置交易</view>
      <view class="item-desc">发布与查看闲置物品</view>
    </view>
    <view class="quick" bindtap="goActivity">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="/assets/icons/star.png" mode="aspectFit" />
      </view>
      <view class="item-title">活动专区</view>
      <view class="item-desc">查看社区活动与报名</view>
    </view>
  </view>

  <view wx:if="{{recommendations.length > 0}}" class="recommend-section">
    <view class="group-title">为您推荐</view>
    <view
      wx:for="{{recommendations}}"
      wx:key="serviceId"
      class="item recommend-card"
    >
      <view class="recommend-main">
        <view class="recommend-body">
          <view class="item-title">{{item.serviceName}}</view>
          <view class="item-desc">{{item.reason}}</view>
        </view>
        <view class="recommend-price">￥{{item.price}}</view>
      </view>
      <view class="recommend-action" data-item="{{item}}" bindtap="openRecommendation">查看详情</view>
    </view>
  </view>

  <view wx:if="{{popupVisible}}" class="popup-mask">
    <view class="popup-sheet">
      <view class="popup-header">
        <view class="popup-title">为您推荐</view>
        <view class="popup-close" bindtap="closePopup">稍后再看</view>
      </view>
      <view class="popup-subtitle">基于业主画像优先展示 1-2 条服务建议</view>
      <view wx:for="{{popupRecommendations}}" wx:key="serviceId" class="popup-card">
        <image wx:if="{{item.imageUrl}}" class="popup-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="popup-body">
          <view class="popup-name">{{item.serviceName}}</view>
          <view class="popup-reason">{{item.reason}}</view>
          <view class="popup-footer">
            <view class="popup-price">￥{{item.price}}</view>
            <view class="popup-btn" data-item="{{item}}" bindtap="openRecommendation">查看详情</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
