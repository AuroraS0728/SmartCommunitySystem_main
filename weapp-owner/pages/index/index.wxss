.home-hero {
  margin-bottom: 26rpx;
}

.banner-swiper {
  height: 280rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.58));
}

.banner-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 26rpx;
}

.quick {
  padding: 22rpx;
  border: 1rpx solid #e0e7ff;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.quick-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #eaf2f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
}

.recommend-section {
  margin-top: 26rpx;
}

.recommend-card {
  padding: 28rpx;
}

.recommend-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.recommend-body {
  flex: 1;
  min-width: 0;
}

.recommend-price {
  flex-shrink: 0;
  color: #ef4444;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.recommend-action {
  margin-top: 22rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #2a6dff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.popup-sheet {
  width: 100%;
  min-height: 46vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 24rpx 36rpx;
}

.popup-header,
.popup-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.popup-close,
.popup-subtitle,
.popup-reason {
  color: #64748b;
  font-size: 24rpx;
}

.popup-subtitle {
  margin: 12rpx 0 18rpx;
}

.popup-card {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.popup-image {
  width: 180rpx;
  height: 140rpx;
  border-radius: 16rpx;
}

.popup-name {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.popup-price {
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 700;
}

.popup-btn {
  min-width: 144rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #2a6dff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}
