.home-hero {
  margin-bottom: 26rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 26rpx;
}

.quick {
  padding: 22rpx;
  border: 1rpx solid #e0e7ff;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.quick-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #eaf2f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
}

.recommend-section {
  margin-top: 26rpx;
}

.recommend-card {
  padding: 28rpx;
}

.recommend-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.recommend-body {
  flex: 1;
  min-width: 0;
}

.recommend-price {
  flex-shrink: 0;
  color: #ef4444;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.recommend-action {
  margin-top: 22rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #2a6dff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
