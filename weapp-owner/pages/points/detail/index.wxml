<view class="section">
  <view class="hero">
    <view class="hero-title">积分明细</view>
    <view class="hero-desc">当前可用积分：{{ points }}</view>
  </view>

  <view wx:if="{{!records.length}}" class="empty">暂无积分流水</view>

  <view wx:for="{{records}}" wx:key="id" class="item">
    <view class="row-between">
      <view class="item-title">{{ item.typeText }}</view>
      <view class="change {{item.changeClass}}">{{ item.changeText }}</view>
    </view>
    <view class="item-desc">变动前：{{ item.beforePoints || 0 }}，变动后：{{ item.afterPoints || 0 }}</view>
    <view class="meta">{{ item.createTimeText }}</view>
  </view>
</view>
