<view class="section">
  <view class="hero">
    <view class="hero-title">停车费订单</view>
    <view class="hero-desc">当前可用积分：{{ points }}</view>
  </view>

  <view wx:if="{{!orders.length}}" class="empty">暂无停车订单</view>

  <view wx:for="{{orders}}" wx:key="id" class="item">
    <view class="row-between">
      <view class="item-title">{{ item.orderTypeText }}</view>
      <view class="status-tag">{{ item.statusText }}</view>
    </view>
    <view class="item-desc">订单ID：{{ item.id }}</view>
    <view class="item-desc">车牌号：{{ item.vehicleNo || '--' }}</view>
    <view class="item-desc">金额：{{ item.amount || 0 }} 元</view>
    <view class="item-desc">需支付积分：{{ item.needPoints }}</view>

    <view
      wx:if="{{item.canPay}}"
      class="btn pay-btn"
      bindtap="onPayOrder"
      data-id="{{item.id}}"
      data-points="{{item.needPoints}}"
      data-business-type="{{item.businessType}}"
    >
      立即支付
    </view>
    <view wx:else class="paid-text">该订单已支付</view>
  </view>
</view>
