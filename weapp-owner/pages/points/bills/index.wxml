<view class="section">
  <view class="hero">
    <view class="hero-title">物业费账单</view>
    <view class="hero-desc">费用公式：面积 × 5 元/月（历史账单锁定快照）</view>
  </view>

  <view wx:if="{{!bills.length}}" class="empty">暂无物业费账单</view>

  <view wx:for="{{bills}}" wx:key="id" class="item">
    <view class="row-between">
      <view class="item-title">账期：{{ item.billPeriod || '--' }}</view>
      <view class="status-tag">{{ item.statusText }}</view>
    </view>
    <view class="item-desc">面积：{{ item.areaText }} ㎡</view>
    <view class="item-desc">单价：{{ item.unitPriceText }} 元/㎡·月</view>
    <view class="item-desc">应缴金额：{{ item.amountText }} 元</view>
    <view class="item-desc">截止日期：{{ item.dueDateText }}</view>

    <view wx:if="{{item.canPay}}" class="btn pay-btn" bindtap="onPayBill" data-id="{{item.id}}">
      微信支付（模拟）
    </view>
    <view wx:else class="paid-text">该账单已支付</view>
  </view>
</view>
