<view class="section">
  <view class="hero">
    <view class="hero-title">费用缴纳</view>
  </view>

  <view wx:if="{{!bills.length}}" class="empty">暂无可缴费账单</view>

  <view wx:for="{{bills}}" wx:key="rowId" class="item">
    <view class="row-between">
      <view class="item-title">{{ item.businessTypeText }}</view>
      <view class="status-tag">{{ item.statusText }}</view>
    </view>
    <view class="item-desc">房产号：{{ item.propertyCodeText }}</view>
    <view class="item-desc">房主：{{ item.ownerNameText }}</view>
    <view class="item-desc">业务标识：{{ item.businessRefText }}</view>
    <view class="item-desc">缴费主体：{{ item.subjectName || '--' }}</view>
    <view class="item-desc">应缴金额：¥{{ item.amountText }}</view>
    <view class="item-desc">已缴金额：¥{{ item.paidAmountText }}</view>
    <view class="item-desc">应付积分：{{ item.needPointsText }}</view>
    <view class="item-desc">截止日期：{{ item.dueDateText }}</view>

    <view
      wx:if="{{item.canPay}}"
      class="btn pay-btn"
      bindtap="onPayBill"
      data-business-type="{{item.businessType}}"
      data-business-id="{{item.businessId}}"
      data-need-points="{{item.needPointsText}}"
      data-type-text="{{item.businessTypeText}}"
      data-subject-name="{{item.subjectName}}"
    >
      立即积分支付
    </view>
    <view wx:else class="paid-text">该账单已支付</view>
  </view>
</view>
