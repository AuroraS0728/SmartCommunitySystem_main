<view class="section">
  <view class="item form-card">
    <view class="item-title">填写报名信息</view>
    <view class="form-item">
      <view class="form-label">姓名</view>
      <input class="form-input" data-field="nickname" value="{{form.nickname}}" bindinput="handleInput" placeholder="请输入姓名" />
    </view>
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" data-field="phone" value="{{form.phone}}" bindinput="handleInput" placeholder="请输入手机号" />
    </view>
    <view class="form-item">
      <view class="form-label">年龄</view>
      <input class="form-input" data-field="age" type="number" value="{{form.age}}" bindinput="handleInput" placeholder="请输入年龄" />
    </view>
    <view class="switch-row">
      <view class="switch-item">
        <text>携带儿童</text>
        <switch checked="{{Number(form.hasChild) === 1}}" data-field="hasChild" bindchange="handleSwitch" />
      </view>
      <view class="switch-item">
        <text>携带宠物</text>
        <switch checked="{{Number(form.hasPet) === 1}}" data-field="hasPet" bindchange="handleSwitch" />
      </view>
    </view>
    <view class="form-item">
      <view class="form-label">备注</view>
      <textarea class="form-textarea" data-field="remark" value="{{form.remark}}" bindinput="handleInput" placeholder="选填" />
    </view>
    <button class="submit-btn" loading="{{submitting}}" bindtap="submit">提交报名</button>
  </view>
</view>
