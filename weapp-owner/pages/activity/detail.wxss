.cover {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.detail-card {
  padding: 26rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(42, 109, 255, 0.12);
  color: #2a6dff;
  font-size: 22rpx;
}

.info-line,
.my-status {
  margin-top: 14rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.6;
}

.my-status {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #1d4ed8;
}

.bottom-action {
  margin-top: 24rpx;
}

.primary-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 18rpx;
  background: #2a6dff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
