.points-card {
  border-color: #e0e7ff;
  background: #ffffff;
}

.points-value {
  color: #2a6dff;
  font-size: 42rpx;
  font-weight: 700;
}

.service-grid-card {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.service-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 144rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e0e7ff;
  background: #ffffff;
}

.service-cell-active {
  border-color: #2a6dff;
  background: #eef4ff;
}

.service-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 12rpx;
  background: #eaf2f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-icon-image {
  width: 34rpx;
  height: 34rpx;
}

.service-name {
  margin-top: 12rpx;
  color: #4a4a4a;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.4;
}

.add-on-card {
  overflow: hidden;
  padding: 0;
  border: 2rpx solid transparent;
}

.add-on-card.is-active {
  border-color: #2a6dff;
  box-shadow: 0 12rpx 28rpx rgba(42, 109, 255, 0.12);
}

.add-on-image {
  width: 100%;
  height: 220rpx;
  display: block;
}

.add-on-body {
  padding: 22rpx 24rpx 24rpx;
}

.row-start {
  align-items: flex-start;
}

.add-on-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2a6dff;
  font-size: 20rpx;
  font-weight: 600;
}

.price,
.booking-price {
  color: #ef4444;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.booking-card {
  padding: 26rpx;
}

.booking-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.label {
  margin: 18rpx 0 12rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 600;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-value {
  min-width: 260rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dbe3f0;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 26rpx;
  text-align: center;
}

.slot-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.slot {
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dbe3f0;
  background: #f8fafc;
  color: #334155;
  font-size: 24rpx;
  text-align: center;
}

.slot-active {
  border-color: #2a6dff;
  background: #eef4ff;
  color: #2a6dff;
  font-weight: 600;
}

.remark-box {
  width: 100%;
  min-height: 180rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dbe3f0;
  background: #f8fafc;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #111827;
}

.submit-btn {
  margin-top: 26rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #2a6dff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  padding: 24rpx;
}

.order-status {
  color: #2a6dff;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-card {
  padding: 28rpx;
}

.compact-empty {
  margin-bottom: 10rpx;
}
