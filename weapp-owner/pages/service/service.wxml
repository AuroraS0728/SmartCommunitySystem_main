<view class="section">
  <view class="hero">
    <view class="hero-title">服务中心</view>
    <view class="hero-desc">{{ guestMode ? '游客可浏览服务目录，办理业务需登录' : '物业服务统一办理入口' }}</view>
  </view>

  <view class="item points-card">
    <view class="row-between">
      <view class="item-title">当前可用积分</view>
      <view class="points-value">{{ points }}</view>
    </view>
    <view class="item-desc">1 积分 = 1 元，可用于物业费和停车费支付</view>
    <view class="link" data-url="/pages/points/detail/index" bindtap="ensureLoginAndNavigate">查看积分明细 ></view>
  </view>

  <view class="group-title">核心服务</view>
  <view class="item service-grid-card">
    <view class="service-cell" data-url="/pages/repair/submit" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/repair.png" mode="aspectFit" />
      </view>
      <view class="service-name">报事报修</view>
    </view>
    <view class="service-cell" data-url="/pages/points/bills/index" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/fee.png" mode="aspectFit" />
      </view>
      <view class="service-name">物业缴费</view>
    </view>
    <view class="service-cell" data-url="/pages/door/invite" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/invite.png" mode="aspectFit" />
      </view>
      <view class="service-name">访客邀请</view>
    </view>
    <view class="service-cell" data-url="/pages/points/parking/index" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/parking.png" mode="aspectFit" />
      </view>
      <view class="service-name">车牌车位管理</view>
    </view>
    <view class="service-cell" data-url="/pages/neighbor/secondhand/list" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/house.png" mode="aspectFit" />
      </view>
      <view class="service-name">租售管理</view>
    </view>
    <view class="service-cell" data-url="/pages/neighbor/secondhand/list" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/rent-sale.png" mode="aspectFit" />
      </view>
      <view class="service-name">闲置交易</view>
    </view>
    <view class="service-cell" data-url="/pages/activity/list" bindtap="ensureLoginAndNavigate">
      <view class="service-icon">
        <image class="service-icon-image" src="/assets/icons/star.png" mode="aspectFit" />
      </view>
      <view class="service-name">活动专区</view>
    </view>
  </view>

  <view class="group-title">其他服务</view>
  <view class="item nav-item" data-url="/pages/repair/list" bindtap="ensureLoginAndNavigate">
    <view class="nav-body">
      <view class="item-title">报修列表</view>
      <view class="item-desc">查看工单状态与处理进度</view>
    </view>
    <view class="nav-arrow">></view>
  </view>
  <view class="item nav-item" data-url="/pages/notice/list" bindtap="ensureLoginAndNavigate">
    <view class="nav-body">
      <view class="item-title">社区公告</view>
      <view class="item-desc">查看最新通知和提醒</view>
    </view>
    <view class="nav-arrow">></view>
  </view>
  <view class="item nav-item" data-url="/pages/neighbor/lostfound/list" bindtap="ensureLoginAndNavigate">
    <view class="nav-body">
      <view class="item-title">失物招领</view>
      <view class="item-desc">失物/招领发布与认领流程</view>
    </view>
    <view class="nav-arrow">></view>
  </view>
  <view class="item nav-item" data-url="/pages/activity/my" bindtap="ensureLoginAndNavigate">
    <view class="nav-body">
      <view class="item-title">我的活动</view>
      <view class="item-desc">查看活动报名记录和审核状态</view>
    </view>
    <view class="nav-arrow">></view>
  </view>
</view>
