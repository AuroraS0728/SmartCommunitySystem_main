<view class="section">
  <view class="hero">
    <view class="hero-title">首次登录请修改密码</view>
    <view class="hero-desc">未完成改密前，系统功能不可用</view>
  </view>

  <view class="item">
    <view class="field-label">旧密码</view>
    <input
      class="input"
      type="password"
      password
      maxlength="6"
      value="{{oldPassword}}"
      bindinput="onOldInput"
      placeholder="请输入当前6位密码"
    />

    <view class="field-label">新密码</view>
    <input
      class="input"
      type="password"
      password
      maxlength="6"
      value="{{newPassword}}"
      bindinput="onNewInput"
      placeholder="请输入新的6位数字密码"
    />

    <view class="field-label">确认新密码</view>
    <input
      class="input"
      type="password"
      password
      maxlength="6"
      value="{{confirmPassword}}"
      bindinput="onConfirmInput"
      placeholder="请再次输入新密码"
    />

    <button class="btn" loading="{{loading}}" bindtap="submit">确认修改</button>
  </view>
</view>
