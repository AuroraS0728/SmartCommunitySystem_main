.section {
  padding-top: 62rpx;
  padding-bottom: 108rpx;
}

.login-card {
  margin-top: 28rpx;
  padding-top: 44rpx;
  padding-bottom: 50rpx;
}

.role-switch {
  margin-bottom: 34rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  display: flex;
  gap: 14rpx;
}

.role-item {
  flex: 1;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
}

.login-card .input {
  min-height: 104rpx;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
  line-height: 1.4;
}

.role-item.active {
  background: #2563eb;
  color: #fff;
  box-shadow: 0 8rpx 18rpx -14rpx rgba(37, 99, 235, 0.85);
}

.tip {
  margin-top: 22rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.8;
}

.login-btn {
  margin-top: 40rpx;
}

.register-link {
  margin-top: 8rpx;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}

.guest-entry {
  margin-top: 22rpx;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
}
