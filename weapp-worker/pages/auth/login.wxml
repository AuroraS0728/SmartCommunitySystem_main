<view class="section">
  <view class="hero">
    <view class="hero-title">智慧社区维修端</view>
    <view class="hero-desc">登录后处理工单、验收与进度反馈</view>
  </view>

  <view class="item">
    <view class="field-label">维修账号</view>
    <input
      class="input"
      type="text"
      maxlength="10"
      placeholder="JZWX + 6位数字"
      value="{{account}}"
      bindinput="onAccountInput"
    />

    <view class="field-label">登录密码</view>
    <input
      class="input"
      type="password"
      password
      maxlength="6"
      placeholder="6位倒序数字密码"
      value="{{password}}"
      bindinput="onPasswordInput"
    />

    <view class="tip">维修账号规则：JZWX + 随机6位数字，密码为这6位数字倒序。</view>
    <button class="btn" loading="{{loading}}" bindtap="submit">登录</button>
  </view>
</view>
