page {
  background: #f3f6fb;
  color: #0f172a;
  font-size: 30rpx;
  line-height: 1.72;
}

navigator {
  color: inherit;
}

.section {
  padding: 44rpx 40rpx 62rpx;
}

.hero {
  margin-bottom: 38rpx;
  padding: 44rpx 40rpx;
  border-radius: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #115e59, #0f766e);
  box-shadow: 0 18rpx 42rpx -24rpx rgba(15, 118, 110, 0.72);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 18rpx;
  color: #ccfbf1;
  font-size: 26rpx;
}

.item {
  margin-bottom: 30rpx;
  padding: 38rpx 34rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx -24rpx rgba(15, 23, 42, 0.65);
}

.field-label {
  margin-bottom: 18rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  margin-bottom: 30rpx;
  padding: 28rpx 28rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 18rpx;
  background: #f8fafc;
  line-height: 1.45;
}

.picker,
.picker-trigger {
  min-height: 96rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  border-radius: 18rpx;
}

.tip {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.btn {
  margin-top: 14rpx;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #0f766e, #0d9488);
  box-shadow: 0 12rpx 24rpx -16rpx rgba(15, 118, 110, 0.75);
}
